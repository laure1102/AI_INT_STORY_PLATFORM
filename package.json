{
  "name": "story-mgr",
  "private": true,
  "packageManager": "pnpm@10.31.0",
  "scripts": {
    "dev": "concurrently \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "pnpm --filter @story-mgr/api dev",
    "dev:web": "pnpm --filter @story-mgr/web dev",
    "tui": "powershell -NoProfile -Command \"$OutputEncoding = [Console]::OutputEncoding = [System.Text.UTF8Encoding]::new(); chcp 65001 > $null; pnpm --filter @story-mgr/tui-client dev\"",
    "tui:loop-regression": "pnpm --filter @story-mgr/tui-client regression:loop",
    "tui:storyscript-regression": "pnpm --filter @story-mgr/tui-client regression:storyscript",
    "build": "pnpm --filter @story-mgr/api build && pnpm --filter @story-mgr/web build",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "^24.0.1",
    "concurrently": "^9.2.1",
    "typescript": "^5.8.3"
  }
}
