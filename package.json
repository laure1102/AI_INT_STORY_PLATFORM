{
  "name": "story-mgr",
  "private": true,
  "packageManager": "pnpm@10.31.0",
  "scripts": {
    "dev": "concurrently -k --kill-timeout 5000 \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "pnpm --filter @story-mgr/api dev",
    "dev:web": "pnpm --filter @story-mgr/web dev",
    "dev:html": "pnpm --filter @story-mgr/html-client dev",
    "html": "pnpm dev:html",
    "build": "pnpm --filter @story-mgr/api build && pnpm --filter @story-mgr/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "validate:data": "tsx scripts/validate-data.mts",
    "check:lines": "tsx scripts/check-source-lines.mts",
    "check:comments": "tsx scripts/check-source-comments.mts",
    "check": "pnpm check:lines && pnpm check:comments && pnpm typecheck && pnpm test && pnpm validate:data && pnpm build"
  },
  "devDependencies": {
    "@types/node": "^24.0.1",
    "concurrently": "^9.2.1",
    "tsx": "^4.22.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
