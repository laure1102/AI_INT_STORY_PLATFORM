          end: false,
          end_script: '',
          id: 'start',
          player_options: [
            {
              id: 'reply_back_linh',
              next_node_id: 'collector_arrival_time',
              script: '// 【回应催债】\n// 玩家承认花都旧债，并把收账地点引到临河老家。\n${player.debt_huadu_active} = true\n${player.debt_huadu_amount} = 100000\n${player.debt_huadu_linh_appointment} = true\n${player.debt_huadu_msg_sent} = true\n${player.debt_huadu_tone} = 1\n${player.debt_huadu_last_pressure} = 2',
              text: '我已经回临河了，要钱就来临河要。你来，我一定还。',
              visible_expr: '',
            },
          ],
          reminder: {
            enabled: true,
            interval_minutes: 10,
          },
        },
        {
