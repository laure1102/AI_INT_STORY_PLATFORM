              script: '// 【确认见面】\n// 玩家确认次日在汽车站当面清账，后续由结束节点延迟调用见面事件。\n${player.debt_huadu_linh_appointment} = true\n${player.debt_huadu_last_pressure} = 2',
              text: '我在汽车站等你。账当面清。',
              visible_expr: '',
            },
          ],
          reminder: {
