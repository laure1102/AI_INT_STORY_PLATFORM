      descr: '应聘出现后，先把履历看明白。',
      end_script: '// 规则目的：把“先看履历”转成对应池事件，由事件脚本继续推进初聊。\n// 写回内容：不直接改变量，只触发对应池事件。\ninvoke_once pool recruit_zhuli_check_resume',
      id: 'do_recruit_zhuli_followup_check',
      init_script: '',
      location: 'job_agency_linh',
      menu_id: 'recruit_zhuli_menu',
      object_keys: [
        'player',
      ],
      once: false,
      presentation: {
        type: 'silent',
      },
      title: '先看履历',
      visible_expr: '${player.team_zhuli_application_received}',
    },
    {
      bgm: '',
      cooldown_hours: 0,
      descr: '应聘出现后，先放一放再处理。',
      end_script: '// 规则目的：把“暂缓处理”转成对应池事件，保留玩家拖延与观望的选择空间。\n// 写回内容：不直接改变量，只触发对应池事件。\ninvoke_once pool recruit_zhuli_hold',
      id: 'do_recruit_zhuli_followup_hold',
      init_script: '',
      location: 'job_agency_linh',
      menu_id: 'recruit_zhuli_menu',
      object_keys: [
        'player',
      ],
      once: false,
      presentation: {
        type: 'silent',
      },
      title: '暂缓处理',
      visible_expr: '${player.team_zhuli_application_received}',
    },
    {
      bgm: '',
      cooldown_hours: 0,
      descr: '完成第一次沟通后，选择偏强势的管理姿态。',
      end_script: '// 规则目的：把“爽快拍板”转成对应池事件，由事件记录管理姿态，不直接定死录用。\n// 写回内容：不直接改变量，只触发对应池事件。\ninvoke_once pool recruit_zhuli_chat_bold',
      id: 'do_recruit_zhuli_chat_bold',
      init_script: '',
      location: 'office_interview_room',
      menu_id: 'recruit_zhuli_menu',
      object_keys: [
        'player',
        'important:zhuli',
      ],
      once: false,
      presentation: {
        type: 'silent',
      },
      title: '沟通姿态：爽快拍板',
      visible_expr: '${player.team_recruit_stage} >= 3',
    },
    {
      bgm: '',
      cooldown_hours: 0,
      descr: '完成第一次沟通后，选择讲清规则。',
      end_script: '// 规则目的：把“讲清规则”转成对应池事件，由事件记录管理姿态，不直接定死录用。\n// 写回内容：不直接改变量，只触发对应池事件。\ninvoke_once pool recruit_zhuli_chat_rules',
      id: 'do_recruit_zhuli_chat_rules',
      init_script: '',
      location: 'office_interview_room',
      menu_id: 'recruit_zhuli_menu',
      object_keys: [
