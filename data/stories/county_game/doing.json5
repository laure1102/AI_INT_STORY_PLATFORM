      descr: '完成第一次沟通后，选择先试用一天。',
      end_script: '// 规则目的：把“先试用一天”转成对应池事件，由事件记录管理姿态，不直接定死录用。\n// 写回内容：不直接改变量，只触发对应池事件。\ninvoke_once pool recruit_zhuli_chat_trial',
      id: 'do_recruit_zhuli_chat_trial',
      init_script: '',
      location: 'office_interview_room',
      menu_id: 'recruit_zhuli_menu',
      object_keys: [
