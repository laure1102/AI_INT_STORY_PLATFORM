{
  doings: [
    {
      bgm: '',
      cooldown_hours: 24,
      descr: '主动拜访县长，了解当前县域治理重点。',
      end_script: '',
      id: 'visit_mayor_office',
      init_script: '',
      location: 'office_small',
      menu_id: 'official',
      object_keys: [
        'important:xianzhang',
      ],
      once: false,
      presentation: {
        dialogues: [
          {
            content: '县长，我想了解一下县里现在最需要推动的事。',
            speaker_key: 'player',
            speaker_type: 'player',
          },
          {
            content: '先把人稳住，把产业盘活。钱可以发，但县城得有让人留下来的理由。',
            speaker_key: 'important:xianzhang',
            speaker_type: 'object',
          },
        ],
        type: 'dialogue',
      },
      title: '去县长办公室',
      visible_expr: '',
    },
    {
      bgm: '',
      cooldown_hours: 12,
      descr: '去县城娱乐场所看看消费氛围和人流情况。',
      end_script: '',
      id: 'go_ktv_relax',
      init_script: '',
      location: 'jiedao_renshao',
      menu_id: 'entertainment',
      object_keys: [
        'normal:yule_dama',
      ],
      once: false,
      presentation: {
        dialogues: [
          {
            content: '老板，今天想唱歌还是谈点生意？最近县里人气可比以前旺了。',
            speaker_key: 'normal:yule_dama',
            speaker_type: 'object',
          },
          {
            content: '我先看看情况，顺便听听大家最近都在聊什么。',
            speaker_key: 'player',
            speaker_type: 'player',
          },
        ],
        type: 'dialogue',
      },
      title: '去KTV放松一下',
      visible_expr: '',
    },
    {
      bgm: '',
      cooldown_hours: 24,
      descr: '观察县城居民消费升级的苗头。',
      end_script: '',
      id: 'inspect_car_market',
      init_script: '',
      location: 'jiedao_renshao',
      menu_id: 'shopping',
      object_keys: [],
      once: false,
      presentation: {
        message: {
          content: '你在县城汽车市场转了一圈，发现进店咨询的人比上周多了不少。',
          duration_seconds: 3,
        },
        type: 'message',
      },
      title: '去看汽车市场',
      visible_expr: '',
    },
    {
      bgm: '',
      cooldown_hours: 24,
      descr: '玩家主动去县城招聘门店发布助理招聘。入口只负责发起招聘，不替玩家决定文案风格；后续仍由链式剧情承接三种口径选择。',
      end_script: '',
      id: 'do_recruit_zhuli_post',
      init_script: '// 规则目的：玩家主动进入招聘流程时，只负责把主角带到招聘场景，并触发招聘口径选择链路。\n// 读取变量：${player.team_recruit_posted} 用于控制该入口只在首次招聘前开放。\n// 计算规则：主动玩法入口不直接写死招聘结果，而是调用后续口径节点，让玩家继续选择高调、正规或低调。\n// 写回变量：本入口不直接写回持久化结果，只调度招聘链路起点。\ninvoke_once chain recruit_post_style_regular',
      location: 'job_agency_linh',
      menu_id: 'team_ops',
      object_keys: [
        'player',
      ],
      once: true,
      presentation: {
        dialogues: [
          {
            content: '你走进县城那家贴满招工纸的门店，准备先把助理岗位放出去。',
            speaker_key: 'player',
            speaker_type: 'player',
          },
        ],
        type: 'dialogue',
      },
      title: '发布助理招聘',
      visible_expr: '!${player.team_recruit_posted}',
    },
    {
      bgm: '',
      cooldown_hours: 24,
      descr: '第二天收到应聘后，玩家主动去查看这份简历并进入处理分支。该入口承接“今天收到应聘”的状态，不强制立刻沟通。',
      end_script: '',
      id: 'do_recruit_zhuli_followup',
      init_script: '// 规则目的：给玩家一个明确的主动入口来处理次日收到的助理应聘，避免剧情文本承诺了“可去看简历”却没有玩法入口。\n// 读取变量：${player.team_zhuli_application_received}、${player.team_recruit_stage}、${player.team_recruit_response_style}。\n// 计算规则：只有在已收到应聘且尚未处理时，才允许进入该入口；入口本身不替玩家决定立刻沟通还是暂缓。\n// 写回变量：本入口不直接写回持久化结果，只调度应聘查看节点。\ninvoke_once pool recruit_zhuli_application',
      location: 'job_agency_linh',
      menu_id: 'team_ops',
      object_keys: [
        'player',
      ],
      once: false,
      presentation: {
        dialogues: [
          {
            content: '后台那份助理应聘还挂着，简历和留言都等你亲自点开。',
            speaker_key: 'player',
            speaker_type: 'player',
          },
        ],
        type: 'dialogue',
      },
      title: '查看助理应聘',
      visible_expr: '${player.team_zhuli_application_received} && ${player.team_recruit_response_style} == 0',
    },
    {
      bgm: '',
      cooldown_hours: 0,
      descr: '以高曝光方式发布助理招聘。',
      end_script: '// 规则目的：调用高调招聘的池事件，由事件本身记录关注度和次日应聘。\n// 写回内容：不直接改变量，只触发对应池事件。\ninvoke_once pool recruit_post_style_high',
      id: 'do_recruit_zhuli_post_high',
      init_script: '',
      location: 'job_agency_linh',
      menu_id: 'recruit_zhuli_menu',
      object_keys: [
        'player',
      ],
      once: false,
      presentation: {
        type: 'silent',
      },
      title: '高调撒钱发招聘',
      visible_expr: '!${player.team_recruit_posted}',
    },
    {
      bgm: '',
      cooldown_hours: 0,
      descr: '以务实口径发布助理招聘。',
      end_script: '// 规则目的：调用务实招聘的池事件，由事件本身记录关注度和次日应聘。\n// 写回内容：不直接改变量，只触发对应池事件。\ninvoke_once pool recruit_post_style_regular',
      id: 'do_recruit_zhuli_post_regular',
      init_script: '',
      location: 'job_agency_linh',
      menu_id: 'recruit_zhuli_menu',
      object_keys: [
        'player',
      ],
      once: false,
      presentation: {
        type: 'silent',
      },
      title: '务实正规发招聘',
      visible_expr: '!${player.team_recruit_posted}',
    },
    {
      bgm: '',
      cooldown_hours: 0,
      descr: '以低调试水方式发布助理招聘。',
      end_script: '// 规则目的：调用低调招聘的池事件，由事件本身记录关注度和次日应聘。\n// 写回内容：不直接改变量，只触发对应池事件。\ninvoke_once pool recruit_post_style_lowkey',
      id: 'do_recruit_zhuli_post_lowkey',
      init_script: '',
      location: 'job_agency_linh',
      menu_id: 'recruit_zhuli_menu',
      object_keys: [
        'player',
      ],
      once: false,
      presentation: {
        type: 'silent',
      },
      title: '低调试水发招聘',
      visible_expr: '!${player.team_recruit_posted}',
    },
    {
      bgm: '',
      cooldown_hours: 0,
      descr: '应聘出现后，立刻回消息沟通。',
      end_script: '// 规则目的：把“立刻沟通”转成对应池事件，由事件脚本继续推进初聊。\n// 写回内容：不直接改变量，只触发对应池事件。\ninvoke_once pool recruit_zhuli_reply_now',
      id: 'do_recruit_zhuli_followup_now',
      init_script: '',
      location: 'job_agency_linh',
      menu_id: 'recruit_zhuli_menu',
