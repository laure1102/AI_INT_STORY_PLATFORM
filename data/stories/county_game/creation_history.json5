          "completedAt": "2026-06-18T06:53:04.151Z",
          "response": {
            "draft": {
              "title": "花都旧债追到临河",
              "summary": "该批内容成功把‘十万旧债追到老家’改造成可落地的游戏化压力事件：先用手机消息建立现实威胁，再让玩家通过手机动作选择回应口气，最后在次日汽车站落地为可主动处理的见面场景。为了保留玩家自由度，建议补齐联系人配置与 doing 主动入口，让“爽快还钱”成为强爽主选项，同时保留“先稳住”作为开放分支。",
              "arc": "开局第一天·旧账追来",
              "locations": [],
              "roles": [
                {
                  "id": "debt_collector",
                  "name": "彪哥",
                  "zhiye": "收债人",
                  "descr": "花都那边跑账催款的老手，三十多岁，常年在外奔波，穿得不算体面但很利索。说话带点江湖气，压迫感强，但核心目标始终是把账收回来，不是无端闹事。",
                  "prompt": "A realistic Chinese debt collector in a small county setting, male in his 30s, plain dark jacket, worn jeans, practical shoes, carrying an old travel bag, sharp tired eyes, pragmatic and intimidating but not gangster, standing at a county bus station entrance, modern China county-town realism",
                  "important": false,
                  "xingge": "强势务实，压迫感强，但以收回欠款为第一目标。"
                }
              ],
              "items": [],
              "events": [
                {
                  "collectionType": "chain",
                  "id": "huadu_debt_message_ping",
                  "title": "花都旧债发来催款消息",
                  "trigger_mode": "invoke",
                  "trigger_expr": "",
                  "invoke_params": [],
                  "object_keys": [
                    "player",
                    "normal:debt_collector"
                  ],
                  "location": "",
                  "presentation": {
                    "type": "message",
                    "message": {
                      "content": "旧手机联系人发来催债消息。",
                      "duration_seconds": 2
                    }
                  },
                  "init_script": "// 规则目的：激活“花都旧债追到老家”的短链入口，只在未结清时建立一次催债状态。\n// 读取变量：${player.debt_huadu_active} 表示旧债线是否已激活；${player.debt_huadu_cleared} 表示是否已结清；${player.debt_huadu_amount} 表示剩余债务金额。\n// 设计说明：如果旧债尚未激活，就在这里补齐初始状态，保证后续链路可重复读取；若已激活则不覆盖玩家已有进度。\n// 写回目标：初始化旧债激活状态、剩余金额、预约状态与态度记录。注意这里只写普通 value 变量，不写 system/calc/call。\nif (!${player.debt_huadu_active} && !${player.debt_huadu_cleared}) {\n  ${player.debt_huadu_active} = true\n  ${player.debt_huadu_amount} = 100000\n  ${player.debt_huadu_linh_appointment} = false\n  ${player.debt_huadu_tone} = 0\n}\n\n// 规则目的：把催债消息缓存为已触发，供后续条件与联系人主动消息规则读取。\n${player.debt_huadu_msg_sent} = true\n${player.debt_huadu_last_pressure} = 1\n\n// 运行时消息：直接把收债人来信写进手机记录，形成结构化手机体验。\ncontact_send_from(\"normal:debt_collector\", \"欠我的十万，该还了。你要是还装死，我就顺着你老家的地址过去找你。\")\n\n// 规则目的：首次被旧账追上时，形成一点现实压力与安保焦虑。\n${player.attr_anbao} = Math.max(0, ${player.attr_anbao} - 2)",
                  "end_script": "",
                  "next": [],
                  "bgm": ""
                },
                {
                  "collectionType": "chain",
                  "id": "huadu_debt_reply_steady",
                  "title": "回话：你来临河，我到站就给",
                  "trigger_mode": "invoke",
                  "trigger_expr": "",
                  "invoke_params": [],
                  "object_keys": [
                    "player",
                    "normal:debt_collector"
                  ],
                  "location": "",
                  "presentation": {
                    "type": "dialogue",
                    "dialogues": [
                      {
                        "speaker_type": "player",
                        "speaker_key": "player",
                        "content": "我已经回临河了。你要收钱就来，我在老家等你，到了我就给。"
                      },
                      {
                        "speaker_type": "object",
                        "speaker_key": "normal:debt_collector",
                        "content": "行。你人在临河是吧？那你就别动。"
                      },
                      {
                        "speaker_type": "object",
                        "speaker_key": "normal:debt_collector",
                        "content": "明天我到车站，咱们当面把这十万了了。"
                      }
                    ]
                  },
                  "init_script": "",
                  "end_script": "// 规则目的：本节点是玩家的‘正面稳住’回应分支。玩家承诺人在临河、对方到了就给钱。\n// 读取变量：${player.debt_huadu_active}、${player.debt_huadu_amount} 用于确认债务仍有效。\n// 写回目标：记录已约定来临河收账、记录本次回应口气为 1（偏稳），并调度 1 天后的到站收账事件。\nif (${player.debt_huadu_active} && ${player.debt_huadu_amount} > 0) {\n  ${player.debt_huadu_linh_appointment} = true\n  ${player.debt_huadu_tone} = 1\n  ${player.debt_huadu_last_pressure} = 1\n  invoke_once chain debt_collector_arrives_linh_1d delay_days=1\n}\n\n// 运行时消息：把玩家与对方的关键对话直接写入手机记录。\ncontact_send_to(\"normal:debt_collector\", \"我已经回临河了。你要收钱就来，我在老家等你，到了我就给。\")\ncontact_send_from(\"normal:debt_collector\", \"行，你在临河等着。明天我过去，到了车站给你打电话。\")",
                  "next": [],
                  "bgm": ""
                },
                {
                  "collectionType": "chain",
                  "id": "huadu_debt_reply_delay",
                  "title": "回话：明天来临河，当面了结",
                  "trigger_mode": "invoke",
                  "trigger_expr": "",
                  "invoke_params": [],
                  "object_keys": [
                    "player",
                    "normal:debt_collector"
                  ],
                  "location": "",
                  "presentation": {
                    "type": "dialogue",
                    "dialogues": [
                      {
                        "speaker_type": "player",
                        "speaker_key": "player",
                        "content": "我人在老家，别急，明天你过来，当面把这事了了。"
                      },
                      {
                        "speaker_type": "object",
                        "speaker_key": "normal:debt_collector",
                        "content": "你最好真是这意思。"
                      },
                      {
                        "speaker_type": "object",
                        "speaker_key": "normal:debt_collector",
                        "content": "明天临河车站见，我人到了你别躲。"
                      }
                    ]
                  },
                  "init_script": "",
                  "end_script": "// 规则目的：本节点是玩家的‘先稳住、明天见面谈’回应分支。\n// 读取变量：${player.debt_huadu_active}、${player.debt_huadu_amount}。\n// 写回目标：记录已约定来临河收账、记录口气为 2（偏谈判/拖字诀），并调度 1 天后的到站收账事件。\nif (${player.debt_huadu_active} && ${player.debt_huadu_amount} > 0) {\n  ${player.debt_huadu_linh_appointment} = true\n  ${player.debt_huadu_tone} = 2\n  ${player.debt_huadu_last_pressure} = 2\n  invoke_once chain debt_collector_arrives_linh_1d delay_days=1\n}\n\n// 运行时消息：写入双方确认“明天临河见”的手机记录，便于玩家回看。\ncontact_send_to(\"normal:debt_collector\", \"我人在老家，别急，明天你过来，当面把这事了了。\")\ncontact_send_from(\"normal:debt_collector\", \"少给我绕。行，明天我到临河车站，你别再换地方。\")",
                  "next": [],
                  "bgm": ""
                },
                {
                  "collectionType": "chain",
                  "id": "huadu_debt_reply_provoke",
                  "title": "回话：你真敢来，我就真敢当面结",
                  "trigger_mode": "invoke",
                  "trigger_expr": "",
                  "invoke_params": [],
                  "object_keys": [
                    "player",
                    "normal:debt_collector"
                  ],
                  "location": "",
                  "presentation": {
                    "type": "dialogue",
                    "dialogues": [
                      {
                        "speaker_type": "player",
                        "speaker_key": "player",
                        "content": "你真敢来临河，我就真敢当面结。少在手机上吓唬人。"
                      },
                      {
                        "speaker_type": "object",
                        "speaker_key": "normal:debt_collector",
                        "content": "呵，嘴还挺硬。"
                      },
                      {
                        "speaker_type": "object",
                        "speaker_key": "normal:debt_collector",
                        "content": "那你就在临河等着。明天车站见，我看你当面还硬不硬。"
                      }
                    ]
                  },
                  "init_script": "",
                  "end_script": "// 规则目的：本节点是玩家的‘嘴硬激将’回应分支。\n// 读取变量：${player.debt_huadu_active}、${player.debt_huadu_amount}。\n// 写回目标：记录已约定来临河收账、记录口气为 3（火药味更足），并调度 1 天后的到站收账事件。\nif (${player.debt_huadu_active} && ${player.debt_huadu_amount} > 0) {\n  ${player.debt_huadu_linh_appointment} = true\n  ${player.debt_huadu_tone} = 3\n  ${player.debt_huadu_last_pressure} = 3\n  invoke_once chain debt_collector_arrives_linh_1d delay_days=1\n}\n\n// 运行时消息：把带火药味的回应写入手机记录，供后续事件读取气氛。\ncontact_send_to(\"normal:debt_collector\", \"你真敢来临河，我就真敢当面结。少在手机上吓唬人。\")\ncontact_send_from(\"normal:debt_collector\", \"行，这话我记着。明天我下车第一件事就是找你。\")",
                  "next": [],
                  "bgm": ""
                },
                {
                  "collectionType": "chain",
                  "id": "debt_collector_arrives_linh_1d",
                  "title": "彪哥到临河汽车站收账",
                  "trigger_mode": "invoke",
                  "trigger_expr": "",
                  "invoke_params": [],
                  "object_keys": [
                    "player",
                    "normal:debt_collector"
                  ],
                  "location": "qichezhan_lvl1",
                  "presentation": {
                    "type": "dialogue",
                    "dialogues": [
                      {
                        "speaker_type": "object",
                        "speaker_key": "normal:debt_collector",
                        "content": "【第二天，临河汽车站门口。长途车刚熄火，站口的人正招呼着去镇上拼车。】"
                      },
                      {
                        "speaker_type": "object",
                        "speaker_key": "normal:debt_collector",
                        "content": "我到了。你这老家车站比我想的小。"
                      },
                      {
                        "speaker_type": "object",
                        "speaker_key": "normal:debt_collector",
                        "content": "十万，今天怎么说？"
                      }
                    ]
                  },
                  "init_script": "// 规则目的：次日到站收账事件只在旧债已激活、已约定到临河且尚未结清时成立。\n// 读取变量：${player.debt_huadu_active}、${player.debt_huadu_linh_appointment}、${player.debt_huadu_amount}、${player.debt_huadu_cleared}、${player.debt_huadu_tone}。\n// 设计说明：这里不直接替玩家做决定，只负责把现场压力落地，并开放两个主动处理入口给玩家选择。\n// 写回目标：刷新最后一次压力等级；解锁“当场还钱”与“先稳住”两个主动入口；写入对方到站消息。\nif (${player.debt_huadu_active} && ${player.debt_huadu_linh_appointment} && !${player.debt_huadu_cleared} && ${player.debt_huadu_amount} > 0) {\n  ${player.debt_huadu_last_pressure} = ${player.debt_huadu_tone}\n  doing_unlock(\"do_debt_pay_full\")\n  doing_unlock(\"do_debt_cannot_pay\")\n}\n\n// 运行时手机记录：对方到站后发消息，增强‘旧生活追到新主场’的现实感。\ncontact_send_from(\"normal:debt_collector\", \"我到临河汽车站了。别让我在站口等你太久。\")",
                  "end_script": "",
                  "next": [],
                  "bgm": ""
                },
                {
                  "collectionType": "chain",
                  "id": "debt_collector_pay_full",
                  "title": "当场爽快还清十万",
                  "trigger_mode": "invoke",
                  "trigger_expr": "",
                  "invoke_params": [],
                  "object_keys": [
                    "player",
                    "normal:debt_collector"
                  ],
                  "location": "qichezhan_lvl1",
                  "presentation": {
                    "type": "dialogue",
                    "dialogues": [
                      {
                        "speaker_type": "player",
                        "speaker_key": "player",
                        "content": "行，十万是吧？现在就转。"
                      },
                      {
                        "speaker_type": "object",
                        "speaker_key": "normal:debt_collector",
                        "content": "……你还真没废话。"
                      },
                      {
                        "speaker_type": "object",
                        "speaker_key": "normal:debt_collector",
                        "content": "到账了。这趟车算我没白坐。以后别让我再追到你老家。"
                      }
                    ]
                  },
                  "init_script": "",
                  "end_script": "// 规则目的：资金足够时实现主要爽点——玩家当场结清十万旧债。\n// 读取变量：${player.money} 是当前现金；${player.debt_huadu_amount} 是剩余债务金额；${player.debt_huadu_active} 与 ${player.debt_huadu_cleared} 用于校验状态。\n// 计算规则：只有当现金大于等于剩余债务金额，才允许直接扣款；这里按当前剩余额一次性结清，避免写死固定值后与未来部分还款扩展冲突。\n// 写回目标：扣除玩家现金、把剩余债务写为 0、标记已结清并关闭激活状态，同时清空本次临河预约状态。\nif (${player.debt_huadu_active} && !${player.debt_huadu_cleared} && ${player.debt_huadu_amount} > 0 && ${player.money} >= ${player.debt_huadu_amount}) {\n  ${player.money} -= ${player.debt_huadu_amount}\n  ${player.debt_huadu_amount} = 0\n  ${player.debt_huadu_cleared} = true\n  ${player.debt_huadu_active} = false\n  ${player.debt_huadu_linh_appointment} = false\n  ${player.debt_huadu_last_pressure} = 0\n}\n\n// 规则目的：旧债结清后，现实压力解除，玩家的安保焦虑略微回升；不额外改写其他属性，避免奖励过度。\n${player.attr_anbao} = Math.min(100, ${player.attr_anbao} + 3)\n\n// 运行时消息：把付款确认写入手机记录，形成完整闭环。\ncontact_send_to(\"normal:debt_collector\", \"行，十万是吧？现在就转。\")\ncontact_send_from(\"normal:debt_collector\", \"到账了。你这次倒是痛快。以后别再让我跨城找你。\")",
                  "next": [],
                  "bgm": ""
                },
                {
                  "collectionType": "chain",
                  "id": "debt_collector_cannot_pay",
                  "title": "手头不够，先稳住收债人",
                  "trigger_mode": "invoke",
                  "trigger_expr": "",
                  "invoke_params": [],
                  "object_keys": [
                    "player",
                    "normal:debt_collector"
                  ],
                  "location": "qichezhan_lvl1",
                  "presentation": {
                    "type": "dialogue",
                    "dialogues": [
                      {
                        "speaker_type": "player",
                        "speaker_key": "player",
                        "content": "我今天手头不够，先别在车站闹，再给我一点时间。"
                      },
                      {
                        "speaker_type": "object",
                        "speaker_key": "normal:debt_collector",
                        "content": "你把我从花都折腾到临河，就给我一句手头不够？"
                      },
                      {
                        "speaker_type": "object",
                        "speaker_key": "normal:debt_collector",
                        "content": "行，我再给你一点时间。但下次我再来，话就没这么轻了。"
                      }
                    ]
                  },
                  "init_script": "",
                  "end_script": "// 规则目的：资金不足时保留开放性，不强行让玩家还清。\n// 读取变量：${player.money}、${player.debt_huadu_amount}、${player.debt_huadu_active}。\n// 计算规则：如果当前现金不足以覆盖剩余债务，则债务继续保留，不扣款；只把状态升级为‘已到站催收但未结清’，便于后续导演继续接追债线。\n// 写回目标：维持债务激活，取消本次预约，提升压力记录，稍微降低安保感，形成后续继续演进的钩子。\nif (${player.debt_huadu_active} && !${player.debt_huadu_cleared} && ${player.debt_huadu_amount} > 0 && ${player.money} < ${player.debt_huadu_amount}) {\n  ${player.debt_huadu_linh_appointment} = false\n  ${player.debt_huadu_last_pressure} = 4\n}\n\n// 规则目的：本次没能结清，玩家会感到现实压力进一步逼近，因此轻微下调安保感。\n${player.attr_anbao} = Math.max(0, ${player.attr_anbao} - 3)\n\n// 运行时消息：写入“暂缓但未解决”的手机记录，留给后续导演继续发酵。\ncontact_send_to(\"normal:debt_collector\", \"我今天手头不够，先别在车站闹，再给我一点时间。\")\ncontact_send_from(\"normal:debt_collector\", \"我给你时间，不是给你消失。下次再让我白跑，话就没今天这么好听了。\")",
                  "next": [],
                  "bgm": ""
                }
              ],
              "variables": [
                {
                  "group": "player",
                  "name": "debt_huadu_active",
                  "description": "花都旧债线是否处于激活追讨状态。true 表示收债人还会继续追债。",
                  "value_type": "value",
