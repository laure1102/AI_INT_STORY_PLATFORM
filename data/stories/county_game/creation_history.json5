                  "trigger_expr": "",
                  "invoke_params": [],
                  "object_keys": [
                    "player",
                    "important:zhuli"
                  ],
                  "location": "office_interview_room",
                  "presentation": {
                    "type": "dialogue",
                    "dialogues": [
                      {
                        "speaker_type": "player",
                        "speaker_key": "player",
                        "content": "“岗位职责、工作节奏、报酬和边界，我都可以现在讲清楚。”"
                      },
                      {
                        "speaker_type": "player",
                        "speaker_key": "player",
                        "content": "“我需要的是能对接、能筛信息、能替我挡住杂音的人，不是摆设。”"
                      },
                      {
                        "speaker_type": "player",
                        "speaker_key": "player",
                        "content": "她那边明显安静了一下。"
                      },
                      {
                        "speaker_type": "object",
                        "speaker_key": "important:zhuli",
                        "content": "“行，这样聊，我能听进去。”"
                      }
                    ]
                  },
                  "init_script": "",
                  "end_script": "// 规则目的：玩家在初聊里采取“讲清规则”姿态，建立更稳定的职业化印象。\n// 读取变量：${player.team_zhuli_first_impression} 当前第一印象值。\n// 计算规则：规则清晰会显著提高专业信任，因此 first_impression 增加 2；后续初始 favor 更高。\n// 写回变量：记录 manage_style=2，提升 first_impression，并进入录用判断节点。\n${player.team_manage_style} = 2\n${player.team_zhuli_first_impression} = ${player.team_zhuli_first_impression} + 2\n${player.team_recruit_stage} = Math.max(${player.team_recruit_stage}, 3)\ninvoke_once chain recruit_zhuli_hire_decision",
                  "next": [],
                  "bgm": ""
                },
                {
                  "collectionType": "chain",
                  "id": "recruit_zhuli_chat_trial",
                  "title": "沟通姿态：先试用一天",
                  "trigger_mode": "invoke",
                  "trigger_expr": "",
                  "invoke_params": [],
                  "object_keys": [
                    "player",
                    "important:zhuli"
                  ],
                  "location": "office_interview_room",
                  "presentation": {
                    "type": "dialogue",
                    "dialogues": [
                      {
                        "speaker_type": "player",
                        "speaker_key": "player",
                        "content": "“我不喜欢空口定终身。先试一天，彼此都看看。”"
                      },
                      {
                        "speaker_type": "object",
                        "speaker_key": "important:zhuli",
                        "content": "“这个说法，反而像真的。”"
                      }
                    ]
                  },
                  "init_script": "",
                  "end_script": "// 规则目的：玩家采取“先试用一天”姿态，体现风险控制，不把关系一次性写满。\n// 读取变量：${player.team_zhuli_first_impression} 当前第一印象值。\n// 计算规则：试用会让对方觉得你谨慎，也让双方都保留退路，因此印象小幅提升 1。\n// 写回变量：记录 manage_style=3，轻微提升印象，进入录用判断节点。\n${player.team_manage_style} = 3\n${player.team_zhuli_first_impression} = ${player.team_zhuli_first_impression} + 1\n${player.team_recruit_stage} = Math.max(${player.team_recruit_stage}, 3)\ninvoke_once chain recruit_zhuli_hire_decision",
                  "next": [],
                  "bgm": ""
                },
                {
