            "id": "debt_collector_arrives_linh_1d",
            "title": "彪哥到临河汽车站收账",
            "trigger_mode": "invoke",
            "trigger_expr": "",
            "invoke_params": [],
            "object_keys": [
              "player",
              "normal:debt_collector"
            ],
            "location": "qichezhan_lvl1",
            "presentation": {
              "type": "dialogue",
              "dialogues": [
                {
                  "speaker_type": "object",
                  "speaker_key": "normal:debt_collector",
                  "content": "【第二天，临河汽车站门口。长途车刚熄火，站口的人正招呼着去镇上拼车。】"
                },
                {
                  "speaker_type": "object",
                  "speaker_key": "normal:debt_collector",
                  "content": "我到了。你这老家车站比我想的小。"
                },
                {
                  "speaker_type": "object",
                  "speaker_key": "normal:debt_collector",
                  "content": "十万，今天怎么说？"
                }
              ]
            },
            "init_script": "// 规则目的：次日到站收账事件只在旧债已激活、已约定到临河且尚未结清时成立。\n// 读取变量：${player.debt_huadu_active}、${player.debt_huadu_linh_appointment}、${player.debt_huadu_amount}、${player.debt_huadu_cleared}、${player.debt_huadu_tone}。\n// 设计说明：这里不直接替玩家做决定，只负责把现场压力落地，并开放两个主动处理入口给玩家选择。\n// 写回目标：刷新最后一次压力等级；解锁“当场还钱”与“先稳住”两个主动入口；写入对方到站消息。\nif (${player.debt_huadu_active} && ${player.debt_huadu_linh_appointment} && !${player.debt_huadu_cleared} && ${player.debt_huadu_amount} > 0) {\n  ${player.debt_huadu_last_pressure} = ${player.debt_huadu_tone}\n  doing_unlock(\"do_debt_pay_full\")\n  doing_unlock(\"do_debt_cannot_pay\")\n}\n\n// 运行时手机记录：对方到站后发消息，增强‘旧生活追到新主场’的现实感。\nphone_send_from_contact(\"normal:debt_collector\", \"我到临河汽车站了。别让我在站口等你太久。\")",
            "end_script": "",
            "next": [],
            "bgm": ""
          },
          {
            "collectionType": "chain",
            "id": "debt_collector_pay_full",
            "title": "当场爽快还清十万",
            "trigger_mode": "invoke",
            "trigger_expr": "",
            "invoke_params": [],
            "object_keys": [
              "player",
              "normal:debt_collector"
            ],
            "location": "qichezhan_lvl1",
            "presentation": {
              "type": "dialogue",
              "dialogues": [
                {
                  "speaker_type": "player",
                  "speaker_key": "player",
                  "content": "行，十万是吧？现在就转。"
                },
                {
                  "speaker_type": "object",
                  "speaker_key": "normal:debt_collector",
                  "content": "……你还真没废话。"
                },
                {
                  "speaker_type": "object",
                  "speaker_key": "normal:debt_collector",
                  "content": "到账了。这趟车算我没白坐。以后别让我再追到你老家。"
                }
              ]
            },
            "init_script": "",
            "end_script": "// 规则目的：资金足够时实现主要爽点——玩家当场结清十万旧债。\n// 读取变量：${player.money} 是当前现金；${player.debt_huadu_amount} 是剩余债务金额；${player.debt_huadu_active} 与 ${player.debt_huadu_cleared} 用于校验状态。\n// 计算规则：只有当现金大于等于剩余债务金额，才允许直接扣款；这里按当前剩余额一次性结清，避免写死固定值后与未来部分还款扩展冲突。\n// 写回目标：扣除玩家现金、把剩余债务写为 0、标记已结清并关闭激活状态，同时清空本次临河预约状态。\nif (${player.debt_huadu_active} && !${player.debt_huadu_cleared} && ${player.debt_huadu_amount} > 0 && ${player.money} >= ${player.debt_huadu_amount}) {\n  ${player.money} -= ${player.debt_huadu_amount}\n  ${player.debt_huadu_amount} = 0\n  ${player.debt_huadu_cleared} = true\n  ${player.debt_huadu_active} = false\n  ${player.debt_huadu_linh_appointment} = false\n  ${player.debt_huadu_last_pressure} = 0\n}\n\n// 规则目的：旧债结清后，现实压力解除，玩家的安保焦虑略微回升；不额外改写其他属性，避免奖励过度。\n${player.attr_anbao} = Math.min(100, ${player.attr_anbao} + 3)\n\n// 运行时消息：把付款确认写入手机记录，形成完整闭环。\nphone_send_to_contact(\"normal:debt_collector\", \"行，十万是吧？现在就转。\")\nphone_send_from_contact(\"normal:debt_collector\", \"到账了。你这次倒是痛快。以后别再让我跨城找你。\")",
            "next": [],
            "bgm": ""
          },
          {
            "collectionType": "chain",
            "id": "debt_collector_cannot_pay",
            "title": "手头不够，先稳住收债人",
            "trigger_mode": "invoke",
            "trigger_expr": "",
            "invoke_params": [],
            "object_keys": [
              "player",
              "normal:debt_collector"
            ],
            "location": "qichezhan_lvl1",
            "presentation": {
              "type": "dialogue",
              "dialogues": [
                {
                  "speaker_type": "player",
                  "speaker_key": "player",
                  "content": "我今天手头不够，先别在车站闹，再给我一点时间。"
                },
                {
                  "speaker_type": "object",
                  "speaker_key": "normal:debt_collector",
                  "content": "你把我从花都折腾到临河，就给我一句手头不够？"
                },
                {
                  "speaker_type": "object",
                  "speaker_key": "normal:debt_collector",
                  "content": "行，我再给你一点时间。但下次我再来，话就没这么轻了。"
                }
              ]
            },
            "init_script": "",
            "end_script": "// 规则目的：资金不足时保留开放性，不强行让玩家还清。\n// 读取变量：${player.money}、${player.debt_huadu_amount}、${player.debt_huadu_active}。\n// 计算规则：如果当前现金不足以覆盖剩余债务，则债务继续保留，不扣款；只把状态升级为‘已到站催收但未结清’，便于后续导演继续接追债线。\n// 写回目标：维持债务激活，取消本次预约，提升压力记录，稍微降低安保感，形成后续继续演进的钩子。\nif (${player.debt_huadu_active} && !${player.debt_huadu_cleared} && ${player.debt_huadu_amount} > 0 && ${player.money} < ${player.debt_huadu_amount}) {\n  ${player.debt_huadu_linh_appointment} = false\n  ${player.debt_huadu_last_pressure} = 4\n}\n\n// 规则目的：本次没能结清，玩家会感到现实压力进一步逼近，因此轻微下调安保感。\n${player.attr_anbao} = Math.max(0, ${player.attr_anbao} - 3)\n\n// 运行时消息：写入“暂缓但未解决”的手机记录，留给后续导演继续发酵。\nphone_send_to_contact(\"normal:debt_collector\", \"我今天手头不够，先别在车站闹，再给我一点时间。\")\nphone_send_from_contact(\"normal:debt_collector\", \"我给你时间，不是给你消失。下次再让我白跑，话就没今天这么好听了。\")",
            "next": [],
            "bgm": ""
          }
        ],
        "variables": [
