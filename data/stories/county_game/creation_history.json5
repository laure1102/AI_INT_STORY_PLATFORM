              "location": "qichezhan_lvl1",
              "bgm": "",
              "end_script": ""
            },
            {
              "id": "do_debt_cannot_pay",
              "title": "去汽车站先稳住他",
              "menu_id": "debt_resolution",
              "descr": "先去见面，把场面压住，再争取后续时间。",
              "visible_expr": "${player.debt_huadu_active} && ${player.debt_huadu_linh_appointment} && !${player.debt_huadu_cleared} && ${player.debt_huadu_amount} > 0",
              "cooldown_hours": 0,
              "once": false,
              "init_script": "// 规则目的：该主动行动对应玩家选择先去见面稳住收债人。\n// 读取变量：${player.debt_huadu_active}、${player.debt_huadu_amount}、${player.money}。\n// 设计说明：当玩家暂时不想或不能立刻结清时，仍可主动去现场处理，保持开放玩法。\n// 写回目标：不直接写变量，只调用正式链事件处理“暂缓未结清”结果。\ninvoke_once chain debt_collector_cannot_pay",
              "object_keys": [
