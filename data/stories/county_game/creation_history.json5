                }
              },
              "init_script": "// 【规则目的】\n// 这个每日规则事件不做“真实逐人统计”，而是根据县域现有指数，近似模拟昨日常住人口的迁入与迁出。\n// 设计目标是让玩家感知：就业、教育、医疗、治安、基建这些长期经营指标，会每天反馈到人口变化，进而影响次日系统发钱金额。\n// 注意：county.renkou 是只读 calc，只读取用于计算；不能直接写。实际持久化必须写回 county.renkou_young / county.renkou_kid / county.renkou_old 三个可写分项。\n\n// 【读取变量】\n// 读取当前总人口与三类人口结构：总人口用于计算流动规模，真正写回的是 young/kid/old 三个 value 分项。\n// 读取就业、教育、医疗、治安、基建指数：就业作为主导项，其余作为家庭迁移与长期定居意愿的辅助项。\nvar totalPop = Math.max(1, ${county.renkou});\nvar young = Math.max(0, ${county.renkou_young});\nvar kid = Math.max(0, ${county.renkou_kid});\nvar old = Math.max(0, ${county.renkou_old});\n\nvar jiuye = Math.max(0, Math.min(100, ${county.jiuye}));\nvar jiaoyu = Math.max(0, ${county.jiaoyu});\nvar yiliao = Math.max(0, ${county.yiliao});\nvar zhian = Math.max(0, Math.min(100, ${county.zhian}));\nvar jijian = Math.max(0, Math.min(100, ${county.jijian}));\n\n// 【指标归一化】\n// 教育、医疗原始量纲和 0-100 指数不同，这里做经验压缩/放大，统一到接近 0-100 的可比较区间。\n// 这样可以避免教育或医疗在公式里因为量纲差异而失真。\nvar eduScore = Math.min(100, jiaoyu / 2);\nvar medScore = Math.min(100, yiliao * 12);\n\n// 【综合吸引力】\n// 就业是人口流动主因，所以权重最高；\n// 教育、医疗会影响带娃家庭、返乡定居和老人随迁；\n// 治安、基建影响居住稳定性与外部人口进入意愿。\nvar attractScore = jiuye * 0.45 + eduScore * 0.18 + medScore * 0.12 + zhian * 0.10 + jijian * 0.15;\n\n// 【人口规模系数】\n// 人口越多，绝对流动人数会略高；但系数被限制在较小区间，避免出现一天暴涨暴跌。\nvar scaleFactor = Math.max(0.85, Math.min(1.15, Math.sqrt(totalPop / 500000)));\n\n// 【迁入迁出计算】\n// 迁入：返乡、尝试就业、家庭投靠、普通落户。\n// 迁出：升学外出、务工外流、异地就医、家庭搬离。\n// 综合吸引力高则迁入更高、迁出更低；综合吸引力低则相反。\nvar popInRaw = totalPop * (0.00018 + Math.max(-20, Math.min(30, attractScore - 50)) * 0.000006) * scaleFactor;\nvar popOutRaw = totalPop * (0.00016 + Math.max(-20, Math.min(30, 50 - attractScore)) * 0.000006) * scaleFactor;\n\n// 【极值保护】\n// 每日人口流动应当是总人口中的极小比例，这里做上下限控制，保持长期经营节奏稳定。\nvar popIn = Math.floor(Math.max(20, Math.min(totalPop * 0.0006, popInRaw)));\nvar popOut = Math.floor(Math.max(20, Math.min(totalPop * 0.0006, popOutRaw)));\n\n// 【按人口结构分配】\n// 年轻人口是流动主体；儿童随家庭与教育资源迁移，教育越强占比略高；\n// 老人随医疗与照护条件迁移，医疗越强占比略高；其余归入年轻人口。\n// 这样能在“简单规则”下，至少体现县域人口结构与教育/医疗条件的关系。\nvar kidShareIn = Math.max(0.10, Math.min(0.18, 0.12 + (eduScore - 50) / 500));\nvar oldShareIn = Math.max(0.06, Math.min(0.14, 0.08 + (medScore - 50) / 500));\nvar youngShareIn = Math.max(0.68, 1 - kidShareIn - oldShareIn);\n\nvar kidShareOut = Math.max(0.10, Math.min(0.18, 0.12 + (50 - eduScore) / 500));\nvar oldShareOut = Math.max(0.06, Math.min(0.14, 0.08 + (50 - medScore) / 500));\nvar youngShareOut = Math.max(0.68, 1 - kidShareOut - oldShareOut);\n\nvar inYoung = Math.floor(popIn * youngShareIn);\nvar inKid = Math.floor(popIn * kidShareIn);\nvar inOld = popIn - inYoung - inKid;\n\nvar outYoung = Math.floor(popOut * youngShareOut);\nvar outKid = Math.floor(popOut * kidShareOut);\nvar outOld = popOut - outYoung - outKid;\n\n// 【安全扣减】\n// 迁出不能把任何年龄段人口扣成负数，因此按现有人口存量做上限保护。\noutYoung = Math.min(outYoung, young);\noutKid = Math.min(outKid, kid);\noutOld = Math.min(outOld, old);\n\nvar actualOut = outYoung + outKid + outOld;\nvar net = popIn - actualOut;\n\n// 【写回人口结构】\n// 不写 county.renkou，因为它是只读 calc；\n// 只写三个可持久化的 value 分项，让总人口按既有 calc_rule 自动更新。\n${county.renkou_young} = Math.max(0, young + inYoung - outYoung);\n${county.renkou_kid} = Math.max(0, kid + inKid - outKid);\n${county.renkou_old} = Math.max(0, old + inOld - outOld);\n\n// 【写回日报缓存】\n// 这些 value 变量供每日消息提示、UI 面板和后续事件读取复用。\n${county.daily_pop_in} = popIn;\n${county.daily_pop_out} = actualOut;\n${county.daily_pop_net} = net;\n\n// 【日报文案】\n// 用户要求：少于 1 万显示具体数字；达到或超过 1 万显示“约 x.xx 万”。\n// 这里不用自定义函数，直接分段生成字符串，降低脚本语法风险。\nvar inText = '';\nif (popIn < 10000) {\n  inText = '' + popIn;\n} else {\n  inText = '约 ' + (popIn / 10000).toFixed(2) + ' 万';\n}\n\nvar outText = '';\nif (actualOut < 10000) {\n  outText = '' + actualOut;\n} else {\n  outText = '约 ' + (actualOut / 10000).toFixed(2) + ' 万';\n}\n\nvar netAbs = Math.abs(net);\nvar netAbsText = '';\nif (netAbs < 10000) {\n  netAbsText = '' + netAbs;\n} else {\n  netAbsText = '约 ' + (netAbs / 10000).toFixed(2) + ' 万';\n}\n\n// 【原因概括】\n// 文案只反馈规则结果，不把未来剧情后果写死，给后续衍生事件保留空间。\nvar reason = '';\nif (attractScore >= 60) {\n  reason = '就业与综合民生条件对人口形成明显吸引';\n} else if (attractScore >= 50) {\n  reason = '就业与生活条件略有改善，人口流动趋稳';\n} else if (attractScore >= 40) {\n  reason = '岗位与公共服务承接力一般，仍有外流压力';\n} else {\n  reason = '就业机会与基础配套偏弱，县域仍在持续失血';\n}\n\nvar netText = '';\nif (net >= 0) {\n  netText = '净流入 ' + netAbsText;\n} else {\n  netText = '净流出 ' + netAbsText;\n}\n\n${county.daily_pop_msg} = '【人口流动日报】昨日迁入 ' + inText + '，迁出 ' + outText + '，' + netText + '。' + reason + '。';",
              "end_script": "",
              "next": [],
              "bgm": "",
              "loop": {
                "mode": "daily",
                "at": "00:00",
                "priority": 20,
                "after": [],
                "before": [
                  "daily_money"
                ]
              }
            }
          ],
          "variables": [],
          "notes": [
            "本批仅生成 1 个 schedule 规则事件，不新增地点、角色、物品、变量，符合用户要求。",
            "严格复用已存在的人口日报缓存变量：county.daily_pop_in、county.daily_pop_out、county.daily_pop_net、county.daily_pop_msg。",
            "严格避免写 county.renkou 与 player.day_give_money 等 calc 变量，改为写回 county.renkou_young / county.renkou_kid / county.renkou_old。",
            "事件表现为 message 系统提示，内容直接读取 ${county.daily_pop_msg}，适合作为玩家每日开机先看的日报反馈。",
            "数值规则已控制为总人口极低比例的日波动，并把人口结构分配从固定比例调整为受教育/医疗轻度影响的动态分配，更贴合用户要求。",
            "该事件作为 daily_money 的前置日结算事件，可由当前 schedule 的 before=[\"daily_money\"] 配合现有 daily_money.after=[\"daily_population_flow\"] 共同保证顺序。",
            "建议最终落库前把 bgm 从空字符串改为 null，以完全贴合 schema。"
          ],
          "warnings": [
            "StoryScript 是否完整支持 const/let/function 声明未在当前规则中明确，因此已改成更保守的 var + 分段赋值写法；如引擎实际只接受更窄子集，需在编辑器中做一次脚本运行验证。",
            "当前公式中的教育与医疗归一化方式基于现有变量量级做经验压缩/放大，建议在实际跑数后观察 7-30 天的人口变化曲线，再做微调。",
            "如果后续县域建设把就业或教育指数拉得很高，虽然已有极值保护，但仍建议与 daily_money 的发钱节奏联调，确认复利增长不会过快。",
            "本事件使用消息提示展示日报，不包含玩家交互选项；若编辑器后续需要“查看详情”按钮，建议通过 UI 面板读取 county.daily_pop_* 缓存，而不是在当前规则事件里追加剧情分支。",
            "需人工确认 presentation.message.content 在当前编辑器运行时是否支持 ${county.daily_pop_msg} 这类变量插值；若不支持，需要改成引擎认可的消息取值方式。",
            "草稿整体可用，但建议修正 bgm=null 与人口结构动态分配两点后再进入下一步。"
          ]
        }
      }
    }
  ]
}
