                  {
                    "id": "do_debt_pay_full",
                    "title": "去汽车站还清十万",
                    "menu_id": "debt_resolution",
                    "descr": "前往汽车站，当场把花都旧债一次性还清。",
                    "visible_expr": "${player.debt_huadu_active} && ${player.debt_huadu_linh_appointment} && !${player.debt_huadu_cleared} && ${player.debt_huadu_amount} > 0 && ${player.money} >= ${player.debt_huadu_amount}",
                    "cooldown_hours": 0,
                    "once": false,
                    "init_script": "// 规则目的：该主动行动对应玩家选择当场结清旧债。\n// 读取变量：${player.debt_huadu_active}、${player.debt_huadu_amount}、${player.money}。\n// 设计说明：这里只负责从主动入口跳转到正式剧情事件，不直接改值，避免与剧情节点逻辑重复。\n// 写回目标：不直接写变量，只调用正式链事件处理扣款与状态收束。\ninvoke_once chain debt_collector_pay_full",
