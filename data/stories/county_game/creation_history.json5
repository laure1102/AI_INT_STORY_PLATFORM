              "type": "message",
              "message": {
                "content": "旧手机联系人发来催债消息。",
                "duration_seconds": 2
              }
            },
            "init_script": "// 规则目的：激活“花都旧债追到老家”的短链入口，只在未结清时建立一次催债状态。\n// 读取变量：${player.debt_huadu_active} 表示旧债线是否已激活；${player.debt_huadu_cleared} 表示是否已结清；${player.debt_huadu_amount} 表示剩余债务金额。\n// 设计说明：如果旧债尚未激活，就在这里补齐初始状态，保证后续链路可重复读取；若已激活则不覆盖玩家已有进度。\n// 写回目标：初始化旧债激活状态、剩余金额、预约状态与态度记录。注意这里只写普通 value 变量，不写 system/calc/call。\nif (!${player.debt_huadu_active} && !${player.debt_huadu_cleared}) {\n  ${player.debt_huadu_active} = true\n  ${player.debt_huadu_amount} = 100000\n  ${player.debt_huadu_linh_appointment} = false\n  ${player.debt_huadu_tone} = 0\n}\n\n// 规则目的：把催债消息缓存为已触发，供后续条件与联系人主动消息规则读取。\n${player.debt_huadu_msg_sent} = true\n${player.debt_huadu_last_pressure} = 1\n\n// 运行时消息：直接把收债人来信写进手机记录，形成结构化手机体验。\nphone_send_from_contact(\"normal:debt_collector\", \"欠我的十万，该还了。你要是还装死，我就顺着你老家的地址过去找你。\")\n\n// 规则目的：首次被旧账追上时，形成一点现实压力与安保焦虑。\n${player.attr_anbao} = Math.max(0, ${player.attr_anbao} - 2)",
            "end_script": "",
            "next": [],
            "bgm": ""
          },
          {
            "collectionType": "chain",
            "id": "huadu_debt_reply_steady",
            "title": "回话：你来临河，我到站就给",
            "trigger_mode": "invoke",
            "trigger_expr": "",
            "invoke_params": [],
            "object_keys": [
              "player",
