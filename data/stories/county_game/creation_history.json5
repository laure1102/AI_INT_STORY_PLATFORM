                "proactive_messages": [
                  {
                    "id": "debt_first_pressure",
                    "enabled": true,
                    "trigger_expr": "${player.debt_huadu_active} && !${player.debt_huadu_msg_sent} && !${player.debt_huadu_cleared}",
                    "cooldown_hours": 9999,
