                  "location": "job_agency_linh",
                  "presentation": {
                    "type": "dialogue",
                    "dialogues": [
                      {
                        "speaker_type": "player",
                        "speaker_key": "player",
                        "content": "两个小时后，招聘网站后台跳出一条新消息。"
                      },
                      {
                        "speaker_type": "player",
                        "speaker_key": "player",
                        "content": "应聘者的简历利落，履历不算夸张，但一看就不是那种只会端茶倒水的花架子。"
                      },
                      {
                        "speaker_type": "player",
                        "speaker_key": "player",
                        "content": "备注里只有一句话：“如果岗位是真的，我今天就能聊。”"
                      }
                    ]
                  },
                  "init_script": "// 规则目的：收到助理的应聘消息，只负责把“出现候选人”这一步明确落地，不直接写死录用。\n// 读取变量：${player.team_recruit_posted} 确认招聘已发布；${player.team_recruit_stage} 判断当前流程是否已进入候选阶段。\n// 计算规则：只有在已发布招聘且尚未收到过该候选人消息时，才推进到“已收到应聘”，避免重复触发。\n// 写回变量：把阶段推进到 2，并记录助理已进入招聘流程。\nif (${player.team_recruit_posted} && !${player.team_zhuli_application_received}) {\n  ${player.team_recruit_stage} = Math.max(${player.team_recruit_stage}, 2)\n  ${player.team_zhuli_application_received} = true\n}",
                  "end_script": "",
                  "next": [],
                  "bgm": ""
                },
                {
                  "collectionType": "chain",
                  "id": "recruit_zhuli_reply_now",
                  "title": "立刻沟通",
                  "trigger_mode": "invoke",
                  "trigger_expr": "",
                  "invoke_params": [],
                  "object_keys": [
                    "player"
                  ],
                  "location": "job_agency_linh",
                  "presentation": {
                    "type": "dialogue",
                    "dialogues": [
                      {
                        "speaker_type": "player",
