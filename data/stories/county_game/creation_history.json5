            "location": "",
            "presentation": {
              "type": "dialogue",
              "dialogues": [
                {
                  "speaker_type": "player",
                  "speaker_key": "player",
                  "content": "我已经回临河了。你要收钱就来，我在老家等你，到了我就给。"
