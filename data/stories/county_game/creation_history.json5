            "init_script": "",
            "end_script": "// 规则目的：本节点是玩家的‘先稳住、明天见面谈’回应分支。\n// 读取变量：${player.debt_huadu_active}、${player.debt_huadu_amount}。\n// 写回目标：记录已约定来临河收账、记录口气为 2（偏谈判/拖字诀），并调度 1 天后的到站收账事件。\nif (${player.debt_huadu_active} && ${player.debt_huadu_amount} > 0) {\n  ${player.debt_huadu_linh_appointment} = true\n  ${player.debt_huadu_tone} = 2\n  ${player.debt_huadu_last_pressure} = 2\n  invoke_once chain debt_collector_arrives_linh_1d delay_days=1\n}\n\n// 运行时消息：写入双方确认“明天临河见”的手机记录，便于玩家回看。\nphone_send_to_contact(\"normal:debt_collector\", \"我人在老家，别急，明天你过来，当面把这事了了。\")\nphone_send_from_contact(\"normal:debt_collector\", \"少给我绕。行，明天我到临河车站，你别再换地方。\")",
