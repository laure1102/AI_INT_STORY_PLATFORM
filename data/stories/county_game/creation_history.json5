                      }
                    ]
                  },
                  "init_script": "",
                  "end_script": "// 规则目的：允许玩家暂缓处理，不把招聘链路强制推到底，同时保留后续再次联系空间。\n// 读取变量：${player.team_recruit_stage} 当前阶段；${player.team_zhuli_application_received} 记录候选人已出现。\n// 写回变量：response_style=3，阶段仍保持在已收到应聘，不录用也不丢失线索。\n${player.team_recruit_response_style} = 3\n${player.team_recruit_stage} = Math.max(${player.team_recruit_stage}, 2)",
                  "next": [],
                  "bgm": ""
                },
                {
                  "collectionType": "chain",
                  "id": "recruit_zhuli_first_chat",
                  "title": "和助理线上初聊",
                  "trigger_mode": "invoke",
                  "trigger_expr": "",
                  "invoke_params": [],
                  "object_keys": [
                    "player",
                    "important:zhuli"
                  ],
                  "location": "office_interview_room",
                  "presentation": {
                    "type": "dialogue",
                    "dialogues": [
                      {
                        "speaker_type": "player",
                        "speaker_key": "player",
                        "content": "视频一接通，对面的女孩先看了你两秒，像是在判断你到底是认真招人，还是一时兴起。"
                      },
                      {
                        "speaker_type": "object",
                        "speaker_key": "important:zhuli",
                        "content": "“我先说明白，我来应聘助理，不是来陪老板演戏的。”"
                      },
                      {
                        "speaker_type": "object",
                        "speaker_key": "important:zhuli",
                        "content": "“如果你真有事要做，我能跟；如果只是砸钱找人围着你转，那我不合适。”"
                      }
                    ]
                  },
                  "init_script": "// 规则目的：进入与助理的第一次正式沟通，根据此前招聘口径提供不同现实质感的第一印象承接。\n// 读取变量：${player.team_recruit_style}、${player.team_zhuli_first_impression}、${player.team_recruit_response_style}。\n// 计算规则：本节点主要负责承接前序选择，不直接锁定录用结果；管理姿态影响交给后续分支决定。\n// 写回变量：本节点不写回持久化结果。",
                  "end_script": "",
                  "next": [
                    "recruit_zhuli_chat_bold",
                    "recruit_zhuli_chat_rules",
                    "recruit_zhuli_chat_trial"
                  ],
                  "bgm": ""
                },
                {
                  "collectionType": "chain",
                  "id": "recruit_zhuli_chat_bold",
                  "title": "沟通姿态：爽快拍板",
                  "trigger_mode": "invoke",
                  "trigger_expr": "",
                  "invoke_params": [],
                  "object_keys": [
                    "player",
                    "important:zhuli"
                  ],
                  "location": "office_interview_room",
                  "presentation": {
                    "type": "dialogue",
                    "dialogues": [
                      {
                        "speaker_type": "player",
                        "speaker_key": "player",
                        "content": "“我不跟你兜圈子。人我要，事我也真要做。你来，待遇不会差。”"
                      },
                      {
                        "speaker_type": "object",
                        "speaker_key": "important:zhuli",
                        "content": "“听着像个痛快老板。”"
                      },
                      {
                        "speaker_type": "object",
                        "speaker_key": "important:zhuli",
                        "content": "“但痛快和靠谱，不是一个词。”"
                      }
                    ]
                  },
                  "init_script": "",
                  "end_script": "// 规则目的：玩家在初聊里采取“爽快拍板”姿态，强化老板气场，但专业感略弱。\n// 读取变量：${player.team_zhuli_first_impression} 当前第一印象值。\n// 计算规则：该姿态会提高对方对玩家执行力的感受，但若前期口径过高调，也可能只把负面印象拉回到中性。\n// 写回变量：记录 manage_style=1，并将 first_impression 提升 1 点；随后进入录用决策节点。\n${player.team_manage_style} = 1\n${player.team_zhuli_first_impression} = ${player.team_zhuli_first_impression} + 1\n${player.team_recruit_stage} = Math.max(${player.team_recruit_stage}, 3)\ninvoke_once chain recruit_zhuli_hire_decision",
                  "next": [],
                  "bgm": ""
                },
                {
                  "collectionType": "chain",
                  "id": "recruit_zhuli_chat_rules",
                  "title": "沟通姿态：讲清规则",
                  "trigger_mode": "invoke",
                  "trigger_expr": "",
                  "invoke_params": [],
                  "object_keys": [
                    "player",
                    "important:zhuli"
                  ],
                  "location": "office_interview_room",
                  "presentation": {
                    "type": "dialogue",
                    "dialogues": [
                      {
                        "speaker_type": "player",
                        "speaker_key": "player",
                        "content": "“岗位职责、工作节奏、报酬和边界，我都可以现在讲清楚。”"
                      },
                      {
                        "speaker_type": "player",
                        "speaker_key": "player",
                        "content": "“我需要的是能对接、能筛信息、能替我挡住杂音的人，不是摆设。”"
                      },
                      {
                        "speaker_type": "player",
                        "speaker_key": "player",
                        "content": "她那边明显安静了一下。"
                      },
                      {
                        "speaker_type": "object",
                        "speaker_key": "important:zhuli",
                        "content": "“行，这样聊，我能听进去。”"
                      }
                    ]
                  },
                  "init_script": "",
                  "end_script": "// 规则目的：玩家在初聊里采取“讲清规则”姿态，建立更稳定的职业化印象。\n// 读取变量：${player.team_zhuli_first_impression} 当前第一印象值。\n// 计算规则：规则清晰会显著提高专业信任，因此 first_impression 增加 2；后续初始 favor 更高。\n// 写回变量：记录 manage_style=2，提升 first_impression，并进入录用决策节点。\n${player.team_manage_style} = 2\n${player.team_zhuli_first_impression} = ${player.team_zhuli_first_impression} + 2\n${player.team_recruit_stage} = Math.max(${player.team_recruit_stage}, 3)\ninvoke_once chain recruit_zhuli_hire_decision",
                  "next": [],
                  "bgm": ""
                },
                {
                  "collectionType": "chain",
                  "id": "recruit_zhuli_chat_trial",
                  "title": "沟通姿态：先试用一天",
                  "trigger_mode": "invoke",
                  "trigger_expr": "",
                  "invoke_params": [],
                  "object_keys": [
                    "player",
                    "important:zhuli"
                  ],
                  "location": "office_interview_room",
                  "presentation": {
                    "type": "dialogue",
                    "dialogues": [
                      {
                        "speaker_type": "player",
                        "speaker_key": "player",
                        "content": "“我不喜欢空口定终身。先试一天，彼此都看看。”"
                      },
                      {
                        "speaker_type": "object",
                        "speaker_key": "important:zhuli",
                        "content": "“这个说法，反而像真的。”"
                      }
                    ]
                  },
                  "init_script": "",
                  "end_script": "// 规则目的：玩家采取“先试用一天”姿态，体现风险控制，不把关系一次性写满。\n// 读取变量：${player.team_zhuli_first_impression} 当前第一印象值。\n// 计算规则：试用会让对方觉得你谨慎，也让双方都保留退路，因此印象小幅提升 1。\n// 写回变量：记录 manage_style=3，轻微提升印象，进入录用决策节点。\n${player.team_manage_style} = 3\n${player.team_zhuli_first_impression} = ${player.team_zhuli_first_impression} + 1\n${player.team_recruit_stage} = Math.max(${player.team_recruit_stage}, 3)\ninvoke_once chain recruit_zhuli_hire_decision",
                  "next": [],
                  "bgm": ""
                }
              ],
