            ],
            "location": "office_interview_room",
            "presentation": {
              "type": "dialogue",
              "dialogues": [
                {
                  "speaker_type": "player",
                  "speaker_key": "player",
                  "content": "聊到最后，真正的问题还是落在了一个点上：你要不要把她真正留在身边。"
                },
                {
                  "speaker_type": "player",
                  "speaker_key": "player",
                  "content": "她没催，只是等你开口。"
                }
              ]
            },
            "init_script": "",
            "end_script": "",
