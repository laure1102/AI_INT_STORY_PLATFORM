        "doing": {
          "menus": [
            {
              "id": "debt_resolution",
              "title": "旧债处理",
              "parent_id": "",
              "sort_order": 30,
              "visible_expr": "${player.debt_huadu_active} && ${player.debt_huadu_linh_appointment} && !${player.debt_huadu_cleared}",
              "descr": "处理花都旧债收账的现场入口。"
            }
          ],
          "doings": [
            {
              "id": "do_debt_pay_full",
              "title": "去汽车站还清十万",
              "menu_id": "debt_resolution",
              "descr": "前往汽车站，当场把花都旧债一次性还清。",
              "visible_expr": "${player.debt_huadu_active} && ${player.debt_huadu_linh_appointment} && !${player.debt_huadu_cleared} && ${player.debt_huadu_amount} > 0 && ${player.money} >= ${player.debt_huadu_amount}",
              "cooldown_hours": 0,
              "once": false,
              "init_script": "// 规则目的：该主动行动对应玩家选择当场结清旧债。\n// 读取变量：${player.debt_huadu_active}、${player.debt_huadu_amount}、${player.money}。\n// 设计说明：这里只负责从主动入口跳转到正式剧情事件，不直接改值，避免与剧情节点逻辑重复。\n// 写回目标：不直接写变量，只调用正式链事件处理扣款与状态收束。\ninvoke_once chain debt_collector_pay_full",
              "object_keys": [
                "player",
                "normal:debt_collector"
              ],
              "presentation": {
                "type": "message",
                "message": {
                  "content": "你朝汽车站口走去，准备把这笔旧账当场了结。",
                  "duration_seconds": 2
                }
              },
              "location": "qichezhan_lvl1",
              "bgm": "",
              "end_script": ""
            },
            {
              "id": "do_debt_cannot_pay",
              "title": "去汽车站先稳住他",
              "menu_id": "debt_resolution",
              "descr": "先去见面，把场面压住，再争取后续时间。",
              "visible_expr": "${player.debt_huadu_active} && ${player.debt_huadu_linh_appointment} && !${player.debt_huadu_cleared} && ${player.debt_huadu_amount} > 0",
              "cooldown_hours": 0,
              "once": false,
              "init_script": "// 规则目的：该主动行动对应玩家选择先去见面稳住收债人。\n// 读取变量：${player.debt_huadu_active}、${player.debt_huadu_amount}、${player.money}。\n// 设计说明：当玩家暂时不想或不能立刻结清时，仍可主动去现场处理，保持开放玩法。\n// 写回目标：不直接写变量，只调用正式链事件处理“暂缓未结清”结果。\ninvoke_once chain debt_collector_cannot_pay",
              "object_keys": [
                "player",
                "normal:debt_collector"
              ],
              "presentation": {
                "type": "message",
                "message": {
                  "content": "你先赶去汽车站，准备把人稳住再说。",
                  "duration_seconds": 2
                }
              },
              "location": "qichezhan_lvl1",
              "bgm": "",
              "end_script": ""
            }
          ]
        },
        "shop": {
          "categories": [],
