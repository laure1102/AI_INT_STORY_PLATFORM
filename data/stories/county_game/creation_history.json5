            "init_script": "",
            "end_script": "// 规则目的：本节点是玩家的‘嘴硬激将’回应分支。\n// 读取变量：${player.debt_huadu_active}、${player.debt_huadu_amount}。\n// 写回目标：记录已约定来临河收账、记录口气为 3（火药味更足），并调度 1 天后的到站收账事件。\nif (${player.debt_huadu_active} && ${player.debt_huadu_amount} > 0) {\n  ${player.debt_huadu_linh_appointment} = true\n  ${player.debt_huadu_tone} = 3\n  ${player.debt_huadu_last_pressure} = 3\n  invoke_once chain debt_collector_arrives_linh_1d delay_days=1\n}\n\n// 运行时消息：把带火药味的回应写入手机记录，供后续事件读取气氛。\nphone_send_to_contact(\"normal:debt_collector\", \"你真敢来临河，我就真敢当面结。少在手机上吓唬人。\")\nphone_send_from_contact(\"normal:debt_collector\", \"行，这话我记着。明天我下车第一件事就是找你。\")",
