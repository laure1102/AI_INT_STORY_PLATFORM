    end_script: '// 【关系推进】\ncontact_add_favor("normal:yule_dama", 2)\n\n// 【事件余波】\ncontact_send_from("normal:yule_dama", "老板，今晚该避的人我都替你挡开了。你要再来，提前吱我一声。")',
