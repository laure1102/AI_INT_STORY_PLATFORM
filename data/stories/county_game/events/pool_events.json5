  {
    bgm: '',
    end_script: '// 【联系人接入】\n// 娱乐场的大妈偏信息贩子和门路角色，适合提供夜生活、人脉和八卦线。\ncontact_add("normal:yule_dama")\ncontact_set_favor("normal:yule_dama", 16)\n\n// 【首条消息】\ncontact_send_from("normal:yule_dama", "老板，这是我号码。你以后想找热闹、找人、找包厢，都可以先问我。")',
    id: 'yule_dama_drop_contact',
