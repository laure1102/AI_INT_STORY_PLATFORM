  {
    bgm: '',
    end_script: '// 【关系推进】\ncontact_add_favor("important:zhuli", 2)\n\n// 【事件余波】\ncontact_send_from("important:zhuli", "老板，今晚这顿我记着了。明早我把整理好的清单发您。")',
