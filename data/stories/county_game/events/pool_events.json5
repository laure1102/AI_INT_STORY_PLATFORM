    end_script: '// 【联系人接入】\n// 初恋属于情感主线入口，先恢复基础联系，再让手机系统承接后续关系推进。\nphone_add_contact("important:chulian")\nphone_set_favor("important:chulian", 35)\n\n// 【首条消息】\nphone_send_from_contact("important:chulian", "刚才走得急，很多话没说。你如果还想聊，就发我消息吧。")',
