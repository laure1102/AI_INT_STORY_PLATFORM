    end_script: '// 【联系人接入】\n// 娱乐场的大妈偏信息贩子和门路角色，适合提供夜生活、人脉和八卦线。\nphone_add_contact("normal:yule_dama")\nphone_set_favor("normal:yule_dama", 16)\n\n// 【首条消息】\nphone_send_from_contact("normal:yule_dama", "老板，这是我号码。你以后想找热闹、找人、找包厢，都可以先问我。")',
