    object_keys: [
      'player',
      'important:zhuli',
    ],
    presentation: {
      dialogues: [
        {
          content: '视频一接通，对面的女孩先看了你两秒，像是在判断你到底是认真招人，还是一时兴起。',
          speaker_key: 'player',
          speaker_type: 'player',
        },
        {
          content: '“我先说明白，我来应聘助理，不是来陪老板演戏的。”',
          speaker_key: 'important:zhuli',
          speaker_type: 'object',
        },
        {
          content: '“如果你真有事要做，我能跟；如果只是砸钱找人围着你转，那我不合适。”',
          speaker_key: 'important:zhuli',
          speaker_type: 'object',
        },
      ],
      type: 'dialogue',
    },
    title: '和助理线上初聊',
    trigger_expr: '',
    trigger_mode: 'invoke',
  },
  {
    end_script: '// 规则目的：玩家在初聊里采取“爽快拍板”姿态，强化老板气场，但专业感略弱。\n// 读取变量：${player.team_zhuli_first_impression} 当前第一印象值。\n// 计算规则：该姿态会提高对方对玩家执行力的感受，但若前期口径过高调，也可能只把负面印象拉回到中性。\n// 写回变量：记录 manage_style=1，并将 first_impression 提升 1 点；随后进入录用判断节点。\n${player.team_manage_style} = 1\n${player.team_zhuli_first_impression} = ${player.team_zhuli_first_impression} + 1\n${player.team_recruit_stage} = Math.max(${player.team_recruit_stage}, 3)\ninvoke_once chain recruit_zhuli_hire_decision',
    id: 'recruit_zhuli_chat_bold',
