    },
    title: '沟通姿态：爽快拍板',
    trigger_expr: '',
    trigger_mode: 'invoke',
  },
  {
    end_script: '// 规则目的：玩家在初聊里采取“讲清规则”姿态，建立更稳定的职业化印象。\n// 读取变量：${player.team_zhuli_first_impression} 当前第一印象值。\n// 计算规则：规则清晰会显著提高专业信任，因此 first_impression 增加 2；后续初始 favor 更高。\n// 写回变量：记录 manage_style=2，提升 first_impression，并进入录用判断节点。\n${player.team_manage_style} = 2\n${player.team_zhuli_first_impression} = ${player.team_zhuli_first_impression} + 2\n${player.team_recruit_stage} = Math.max(${player.team_recruit_stage}, 3)\ninvoke_once chain recruit_zhuli_hire_decision',
