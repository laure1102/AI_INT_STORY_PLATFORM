    title: '先看履历',
    trigger_expr: '',
    trigger_mode: 'invoke',
  },
  {
    end_script: '// 规则目的：允许玩家暂缓处理，不把招聘链路强制推到底，同时保留后续再次联系空间。\n// 读取变量：${player.team_recruit_stage} 当前阶段；${player.team_zhuli_application_received} 记录候选人已出现。\n// 写回变量：response_style=3，阶段仍保持在已收到应聘，不录用也不丢失线索。\n${player.team_recruit_response_style} = 3\n${player.team_recruit_stage} = Math.max(${player.team_recruit_stage}, 2)',
    id: 'recruit_zhuli_hold',
    init_script: '',
