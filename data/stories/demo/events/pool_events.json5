    ],
    title: '街头重逢初恋',
    trigger_expr: '${system.now_day} >= 3 && ${system.now_hour} >= 17 && ${system.now_hour} <= 22 && !contact_has("important:chulian")',
    trigger_mode: 'condition',
  },
  {
    bgm: '',
    presentation: {
      type: 'dialogue',
      dialogues: [
        {
          content: '老板，你还真把我叫出来吃夜宵了啊。',
          speaker_key: 'important:zhuli',
          speaker_type: 'object',
        },
        {
          content: '白天只够说正事，晚上才适合听真话。',
          speaker_key: 'player',
          speaker_type: 'player',
        },
        {
          content: '那我就说真话。县里很多人已经在打听你了，不过我还能替你挡一阵。',
          speaker_key: 'important:zhuli',
          speaker_type: 'object',
        },
      ],
    },
    end_script: "// 【关系推进】\ncontact_add_favor(\"important:zhuli\", 2)\n\n// 【事件余波】\ncontact_send_from(\"important:zhuli\", \"老板，今晚这顿我记着了。明早我把整理好的清单发您。\")",
