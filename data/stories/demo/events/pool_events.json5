    end_script: "// 【关系推进】\ncontact_add_favor(\"normal:start_suanming\", 1)\n\n// 【事件余波】\ncontact_send_from(\"normal:start_suanming\", \"小友，老夫不常提醒人第二遍。真要去南边，先给我发消息。\")",
