          speaker_key: 'important:xianzhang',
          speaker_type: 'object',
        },
      ],
    },
    end_script: "// 【关系推进】\ncontact_add_favor(\"important:xianzhang\", 3)\n\n// 【事件余波】\ncontact_send_from(\"important:xianzhang\", \"你今天这顿饭没白吃。后面真有想法，可以直接跟我通气。\")",
    id: 'contact_xianzhang_private_dinner',
    init_script: '',
    invoke_params: [],
    location: 'office_small',
    object_keys: [
      'important:xianzhang',
    ],
    title: '和县长私下吃饭',
    trigger_expr: '',
    trigger_mode: 'invoke',
  },
  {
    bgm: '',
    presentation: {
      type: 'dialogue',
      dialogues: [
        {
          content: '红包老夫收了。你这卦，问的不是运，是人。',
          speaker_key: 'normal:start_suanming',
          speaker_type: 'object',
