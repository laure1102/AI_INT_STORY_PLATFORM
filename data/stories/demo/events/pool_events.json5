[
  {
    bgm: '',
    presentation: {
      type: 'dialogue',
      dialogues: [
        {
          content: '请问……您就是刚回县里的那位老板吗？',
          speaker_key: 'important:zhuli',
          speaker_type: 'object',
        },
        {
          content: '老板不敢当，不过刚回县里的人，应该就是我。',
          speaker_key: 'player',
          speaker_type: 'player',
        },
        {
          content: '我叫助理，之前一直在外面给人跑事务。听说您想在县里做点事，我或许能帮上忙。',
          speaker_key: 'important:zhuli',
          speaker_type: 'object',
        },
        {
          content: '你消息倒是灵通。',
          speaker_key: 'player',
          speaker_type: 'player',
        },
        {
          content: '小地方，风吹草动传得都快。您要真想做事，身边总得有人先替您跑腿、盯消息、传话。',
          speaker_key: 'important:zhuli',
          speaker_type: 'object',
        },
        {
          content: '行，那你先跟着我试试。正好我现在最缺的，就是一个熟县里门路的人。',
          speaker_key: 'player',
          speaker_type: 'player',
        },
      ],
    },
    end_script: "// 【联系人接入】\n// 助理正式成为主角的第一位现实联系人，后续很多县域经营线都可以从她这里展开。\ncontact_add(\"important:zhuli\")\ncontact_set_favor(\"important:zhuli\", 30)\n\n// 【首条手机消息】\n// 让玩家在第一次认识助理后立刻看到手机系统的价值。\ncontact_send_from(\"important:zhuli\", \"老板，这是我的手机号。我先去把县里的基础情况摸一遍，有进展我随时跟您汇报。\")",
    id: 'zhuli_offer_help',
    init_script: '',
    invoke_params: [],
    location: 'qichezhan_lvl1',
    object_keys: [
      'important:zhuli',
    ],
    title: '助理主动上门',
    trigger_expr: '${system.now_day} >= 1 && !contact_has("important:zhuli") && ${player.money} >= ${player.first_day_give_money}',
    trigger_mode: 'condition',
  },
  {
    bgm: '',
    presentation: {
      type: 'message',
      message: {
        content: '助理给你推来了一个新的联系人号码。',
        duration_seconds: 2,
      },
    },
    end_script: "// 【主线手机铺垫】\n// 县长通过助理递来联系方式，表示他已经注意到主角回县里这件事。\ncontact_add(\"important:xianzhang\")\ncontact_set_favor(\"important:xianzhang\", 22)\ncontact_send_from(\"important:xianzhang\", \"听说你回县里了。有空的话，来县里坐坐。你要是真想做点事，我们可以聊聊。\")",
    id: 'xianzhang_first_contact',
    init_script: '',
    invoke_params: [],
    location: '',
    object_keys: [],
    title: '县长递来联系方式',
    trigger_expr: '${system.now_day} >= 2 && contact_has("important:zhuli") && !contact_has("important:xianzhang")',
    trigger_mode: 'condition',
  },
  {
    bgm: '',
    presentation: {
      type: 'dialogue',
      dialogues: [
        {
          content: '真没想到，会在这条街上和你并排走这么久。',
          speaker_key: 'important:chulian',
          speaker_type: 'object',
        },
        {
          content: '我也没想到你会答应出来。',
          speaker_key: 'player',
          speaker_type: 'player',
        },
        {
          content: '你现在和以前不太一样了。说不上是哪里，就是更让人看不透了。',
          speaker_key: 'important:chulian',
          speaker_type: 'object',
        },
        {
          content: '那你呢？你还是会在夜里把心事都藏起来。',
          speaker_key: 'player',
          speaker_type: 'player',
        },
        {
          content: '……至少今晚，不想藏得那么严实。',
          speaker_key: 'important:chulian',
          speaker_type: 'object',
        },
      ],
    },
    end_script: "// 【关系推进】\n// 这次夜间散步让初恋重新放下了一点防备。\ncontact_add_favor(\"important:chulian\", 3)\n\n// 【事件余波】\n// 让她在会话结束后主动发一条消息，方便玩家继续在手机里接触。\ncontact_send_from(\"important:chulian\", \"今晚……谢谢你陪我走那一段路。\")",
    id: 'contact_chulian_evening_walk',
    init_script: '',
    invoke_params: [],
    location: 'jiedao_renshao',
    object_keys: [
      'important:chulian',
    ],
    title: '和初恋夜里散步',
    trigger_expr: '',
    trigger_mode: 'invoke',
  },
  {
    bgm: '',
    presentation: {
      type: 'dialogue',
      dialogues: [
        {
          content: '小友脚步急，心火旺，兜里倒是有了新财气。',
          speaker_key: 'normal:start_suanming',
          speaker_type: 'object',
        },
        {
          content: '你这开场白，听着像冲着我来的。',
          speaker_key: 'player',
          speaker_type: 'player',
        },
        {
          content: '县里这地方，风刚起的时候，最先乱的是人心。要是以后拿不准，给老夫发个消息。',
          speaker_key: 'normal:start_suanming',
          speaker_type: 'object',
        },
      ],
    },
    end_script: "// 【联系人接入】\n// 老算命属于县城的风向标型角色，先接入手机联系人，方便后续做玄学提示线。\ncontact_add(\"normal:start_suanming\")\ncontact_set_favor(\"normal:start_suanming\", 18)\n\n// 【首条消息】\n// 主动留号，强化“联系人都是剧情关系延伸”的体验。\ncontact_send_from(\"normal:start_suanming\", \"小友，若哪天心里拿不准，就给老夫发个消息。县里这地方，风比人先动。\")",
    id: 'suanming_exchange_contact',
    init_script: '',
    invoke_params: [],
    location: 'jiedao_renshao',
    object_keys: [
      'normal:start_suanming',
    ],
    title: '老算命递来号码',
    trigger_expr: '${system.now_day} >= 1 && ${system.now_hour} >= 9 && ${system.now_hour} <= 18 && !contact_has("normal:start_suanming")',
    trigger_mode: 'condition',
  },
  {
    bgm: '',
    presentation: {
      type: 'dialogue',
      dialogues: [
        {
          content: '老板，第一次来县里夜场吧？这边的人，认个脸比认个名字快。',
          speaker_key: 'normal:yule_dama',
          speaker_type: 'object',
        },
        {
          content: '听起来你很懂这地方的门路。',
          speaker_key: 'player',
          speaker_type: 'player',
        },
        {
          content: '懂不敢说，熟倒是熟。你要以后晚上出来，提前给我打个电话，我替你避开不该碰的人。 ',
          speaker_key: 'normal:yule_dama',
          speaker_type: 'object',
        },
      ],
    },
    end_script: "// 【联系人接入】\n// 娱乐场的大妈偏信息贩子和门路角色，适合提供夜生活、人脉和八卦线。\ncontact_add(\"normal:yule_dama\")\ncontact_set_favor(\"normal:yule_dama\", 16)\n\n// 【首条消息】\ncontact_send_from(\"normal:yule_dama\", \"老板，这是我号码。你以后想找热闹、找人、找包厢，都可以先问我。\")",
    id: 'yule_dama_drop_contact',
    init_script: '',
    invoke_params: [],
    location: 'jiedao_renshao',
    object_keys: [
      'normal:yule_dama',
    ],
    title: '娱乐场大妈留号',
    trigger_expr: '${system.now_day} >= 2 && ${system.now_hour} >= 19 && ${system.now_hour} <= 23 && contact_has("important:zhuli") && !contact_has("normal:yule_dama")',
    trigger_mode: 'condition',
  },
  {
    bgm: '',
    presentation: {
      type: 'dialogue',
      dialogues: [
        {
          content: '……是你？',
          speaker_key: 'important:chulian',
          speaker_type: 'object',
        },
        {
          content: '我还以为，你会先装作没看见我。',
          speaker_key: 'player',
          speaker_type: 'player',
        },
        {
          content: '想过。可县城就这么大，绕也绕不开。',
          speaker_key: 'important:chulian',
          speaker_type: 'object',
        },
        {
          content: '那至少，先别把我当陌生人。',
          speaker_key: 'player',
          speaker_type: 'player',
        },
      ],
    },
    end_script: "// 【联系人接入】\n// 初恋属于情感主线入口，先恢复基础联系，再让手机系统承接后续关系推进。\ncontact_add(\"important:chulian\")\ncontact_set_favor(\"important:chulian\", 35)\n\n// 【首条消息】\ncontact_send_from(\"important:chulian\", \"刚才走得急，很多话没说。你如果还想聊，就发我消息吧。\")",
    id: 'chulian_reconnect_on_street',
    init_script: '',
    invoke_params: [],
    location: 'jiedao_renshao',
    object_keys: [
